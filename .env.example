# ========= Claude Office x CC Switch 本地网关 配置 =========
# 复制本文件为 .env 后按需修改；install.ps1 会自动完成首次复制。
# 所有项都有内置默认值，.env 不是必需的。

# --- 监听 ---
# 网关监听地址与端口。只监听 127.0.0.1 是安全特性，勿改为 0.0.0.0。
EDGE_HOST=127.0.0.1
EDGE_PORT=8790

# --- CC Switch 上游 ---
# CC Switch 内置代理地址（保持默认即可）
CCSWITCH_BASE=http://127.0.0.1:15721
# 通道选择：auto=按 cc-switch.db 自动识别（推荐）
# claude-desktop=旧版 CC Switch（Claude Desktop 分类供应商，路径前缀 /claude-desktop）
# claude=新版 CC Switch（Claude 分类供应商，路径前缀为空）
CCSWITCH_CHANNEL=auto
# cc-switch 数据库位置（只读访问；绝不写入）
# CCSWITCH_DB=%USERPROFILE%\.cc-switch\cc-switch.db

# --- 访问令牌 ---
# 留空 = 任意令牌均可（Office 里填 PROXY_MANAGED 占位即可，凭据由 CC Switch 托管）。
# 设置后 = 必须携带该令牌（更安全，适合多人共机的场景）。
EDGE_TOKEN=

# --- 数据目录 ---
# 文件库/日志存放位置（相对路径基于仓库根目录）
# EDGE_DATA_DIR=runtime

# --- 限额 ---
EDGE_MAX_BODY_BYTES=33554432
EDGE_MAX_FILE_BYTES=33554432
EDGE_MAX_EXTRACT_CHARS=60000
# 访问日志轮转阈值（字节）
EDGE_ACCESS_LOG_MAX=2097152
# 附件总配额（字节），超出后最旧附件自动淘汰；0=不限额（默认 1GiB）
EDGE_FILE_QUOTA_BYTES=1073741824
# 后台维护间隔（秒）：过期清理 + 配额执行（默认 600）
EDGE_PRUNE_INTERVAL=600

# --- 日志 ---
# 1=脱敏的简要访问日志（推荐）；0=静默
EDGE_LOG_REDACT=1
# 1=额外输出请求形状摘要（模型/角色序列/块类型计数，不含正文，排障时短期开启）
EDGE_LOG_SHAPE=0
